# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/alertas_db

# WhatsApp Cloud API (Meta for Developers)
WA_PHONE_NUMBER_ID=tu_phone_number_id
WA_ACCESS_TOKEN=tu_access_token_de_meta
WA_VERIFY_TOKEN=token_secreto_para_verificar_webhook

# Seguridad JWT
SECRET_KEY=clave_secreta_muy_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URLs
BASE_URL=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# Prefijo del módulo (debe coincidir con el mount point)
MODULE_PREFIX=/alertas

# Modo debug (false en producción)
DEBUG=false
